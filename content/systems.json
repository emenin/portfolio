{
  "roles": ["--font-display", "--font-body", "--surface", "--surface-raised", "--surface-light", "--text", "--text-muted", "--text-on-light", "--text-on-action", "--border", "--action", "--focus", "--radius-sm", "--radius-md", "--weight-semibold", "--tracking-heading"],
  "systems": {
    "carbon": {
      "name": "IBM Carbon",
      "short": "Carbon",
      "licence": "Apache-2.0",
      "docs": "https://carbondesignsystem.com/elements/color/tokens/",
      "font": "https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&display=swap",
      "theme": "Gray 100 theme, White theme on light sections",
      "tokens": {
        "--font-display": ["'IBM Plex Sans', sans-serif", "$font-family-sans (IBM Plex Sans)"],
        "--font-body": ["'IBM Plex Sans', sans-serif", "$font-family-sans (IBM Plex Sans)"],
        "--surface": ["#161616", "$background"],
        "--surface-raised": ["#262626", "$layer-01"],
        "--surface-light": ["#f4f4f4", "$background (g10)"],
        "--text": ["#f4f4f4", "$text-primary"],
        "--text-muted": ["#c6c6c6", "$text-secondary"],
        "--text-on-light": ["#161616", "$text-primary (white)"],
        "--text-on-action": ["#161616", "$text-inverse"],
        "--border": ["#393939", "$border-subtle-01"],
        "--action": ["#78a9ff", "$link-primary"],
        "--focus": ["#ffffff", "$focus"],
        "--radius-sm": ["0", "no corner radius"],
        "--radius-md": ["0", "no corner radius"],
        "--weight-semibold": ["400", "productive heading weight"],
        "--tracking-heading": ["0", "type tokens use 0 tracking"]
      },
      "light": {
        "--action": ["#0f62fe", "$link-primary (white)"],
        "--text-on-action": ["#ffffff", "$text-on-color"],
        "--focus": ["#0f62fe", "$focus (white)"]
      },
      "components": {
        ".button.primary": "background:#0f62fe; color:#ffffff; border-color:#0f62fe;",
        ".button": "justify-content:space-between; min-width:200px;",
        ".next-hero h1": "font-weight:300;"
      }
    },
    "material": {
      "name": "Material 3",
      "short": "Material",
      "licence": "Apache-2.0",
      "docs": "https://m3.material.io/styles/color/static/baseline",
      "font": "https://fonts.googleapis.com/css2?family=Roboto:wght@400;500&display=swap",
      "theme": "baseline scheme, dark, light scheme on light sections",
      "tokens": {
        "--font-display": ["Roboto, sans-serif", "md.ref.typeface.brand"],
        "--font-body": ["Roboto, sans-serif", "md.ref.typeface.plain"],
        "--surface": ["#141218", "md.sys.color.surface"],
        "--surface-raised": ["#211f26", "md.sys.color.surface-container"],
        "--surface-light": ["#fef7ff", "md.sys.color.surface (light)"],
        "--text": ["#e6e0e9", "md.sys.color.on-surface"],
        "--text-muted": ["#cac4d0", "md.sys.color.on-surface-variant"],
        "--text-on-light": ["#1d1b20", "md.sys.color.on-surface (light)"],
        "--text-on-action": ["#381e72", "md.sys.color.on-primary"],
        "--border": ["#49454f", "md.sys.color.outline-variant"],
        "--action": ["#d0bcff", "md.sys.color.primary"],
        "--focus": ["#d0bcff", "md.sys.color.primary"],
        "--radius-sm": ["12px", "md.sys.shape.corner.medium"],
        "--radius-md": ["16px", "md.sys.shape.corner.large"],
        "--weight-semibold": ["400", "md.sys.typescale.display weight"],
        "--tracking-heading": ["0", "md.sys.typescale.display tracking"]
      },
      "light": {
        "--action": ["#6750a4", "md.sys.color.primary (light)"],
        "--text-on-action": ["#ffffff", "md.sys.color.on-primary (light)"],
        "--focus": ["#6750a4", "md.sys.color.primary (light)"]
      },
      "components": {
        ".button": "border-radius:100px; padding-inline:var(--space-6);",
        ".question-row": "border-radius:var(--radius-sm);"
      }
    },
    "shadcn": {
      "name": "shadcn/ui",
      "short": "shadcn",
      "licence": "MIT",
      "docs": "https://ui.shadcn.com/themes",
      "font": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap",
      "theme": "zinc theme, dark, light theme on light sections",
      "tokens": {
        "--font-display": ["Inter, sans-serif", "font-sans (Inter)"],
        "--font-body": ["Inter, sans-serif", "font-sans (Inter)"],
        "--surface": ["#09090b", "--background"],
        "--surface-raised": ["#18181b", "--card"],
        "--surface-light": ["#ffffff", "--background (light)"],
        "--text": ["#fafafa", "--foreground"],
        "--text-muted": ["#a1a1aa", "--muted-foreground"],
        "--text-on-light": ["#09090b", "--foreground (light)"],
        "--text-on-action": ["#18181b", "--primary-foreground"],
        "--border": ["#27272a", "--border"],
        "--action": ["#fafafa", "--primary"],
        "--focus": ["#d4d4d8", "--ring"],
        "--radius-sm": ["6px", "--radius (md)"],
        "--radius-md": ["8px", "--radius"],
        "--weight-semibold": ["600", "font-semibold"],
        "--tracking-heading": ["-0.025em", "tracking-tight"]
      },
      "light": {
        "--action": ["#18181b", "--primary (light)"],
        "--text-on-action": ["#fafafa", "--primary-foreground (light)"],
        "--focus": ["#18181b", "--ring (light)"]
      },
      "components": {
        ".button": "min-height:40px; padding-block:var(--space-2);"
      }
    }
  }
}
